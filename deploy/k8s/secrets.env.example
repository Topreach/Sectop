# Example secrets.env (DO NOT COMMIT real secrets)
# Copy this file to secrets.env locally or populate via CI with GitHub secrets.

# Backend JWT secret (strong random string/base64)
JWT_SECRET=

# Database credentials
DB_USERNAME=
DB_PASSWORD=
JDBC_DATABASE_URL=

# Redis
REDIS_HOST=
REDIS_PORT=

# ML service API key and JWT secret
ML_API_KEY=
ML_SERVICE_JWT_SECRET=

# Emergency bypass key (optional)
EMERGENCY_BYPASS_KEY=
