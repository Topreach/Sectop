# Danger Emergence System - Environment Configuration
# Copy this file to .env and fill in your values

# Backend Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=danger_emergence
DB_USER=postgres
DB_PASSWORD=changeme

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT Configuration
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=danger-emergence-backend

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key

# LoRa Configuration
LORA_FREQUENCY=868000000

# Mapbox (for offline maps and geofencing)
# Get your token at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.ey...
LORA_BANDWIDTH=125000
LORA_SPREADING_FACTOR=9
LORA_CODING_RATE=5
LORA_POWER=14

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
