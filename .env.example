# Danger Emergence System - Environment Configuration
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# Backend Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=danger_emergence
DB_USER=postgres
DB_USERNAME=postgres
DB_PASSWORD=D4ng3rEmerg3nc3!2024#Secure
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/danger_emergence

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# MQTT Configuration
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=danger-emergence-backend

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000
ML_API_KEY=

# JWT Configuration
JWT_SECRET=d2Fybml0aS1kYW5nZXItZW1lcmdlbmNlLXNlY3JldC1rZXktZm9yLWhtYWMtc2hhMjU2
JWT_EXPIRATION_HOURS=24

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key

# LoRa Configuration
LORA_FREQUENCY=868000000

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# FCM Push Notification (Firebase Cloud Messaging)
# Get your server key from Firebase Console -> Project Settings -> Cloud Messaging
# Required for push notifications to work
FCM_SERVER_KEY=

# Twilio SMS Gateway Configuration
# Get these from https://console.twilio.com
# Required for SMS alerts to work
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+234XXXXXXXXX

# Paystack Payment Gateway Configuration
# Get your secret key from https://dashboard.paystack.com/#/settings/developer
# Required for subscription payments in Naira (NGN)
PAYSTACK_SECRET_KEY=

# Email / SMTP Configuration (Required for Password Reset)
# MAIL_USERNAME: Your Gmail address
# MAIL_PASSWORD: Gmail App Password (NOT your regular password)
#                Generate at: https://myaccount.google.com/apppasswords
#                Requires 2-Step Verification enabled on your Google Account
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Application Base URL (used in password reset email links and Paystack callback)
# Set this to your server's public URL
APP_BASE_URL=https://sectop.resultscaleai.com
